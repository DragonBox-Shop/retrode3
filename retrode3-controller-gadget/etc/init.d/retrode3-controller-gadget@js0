
#!/bin/sh
# kFreeBSD do not accept scripts as interpreters, using #!/bin/sh and sourcing.
if [ true != "$INIT_D_SCRIPT_SOURCED" ] ; then
    set "$0" "$@"; INIT_D_SCRIPT_SOURCED=true . /lib/init/init-d-script
fi
### BEGIN INIT INFO
# Provides:          retrode3-controller-gadget
# Required-Start:    letux-gadget
# Required-Stop:
# Default-Start:     
# Default-Stop:      0 1 2 3 4 5 6
# Short-Description: Control hidd /dev/HID0 to 3
# Description:       This script adds game controller devices of Retrode3
#                    
### END INIT INFO

# Author: H. Nikolaus Schaller <hns@goldelico.com>

SERVICE=retrode3-controller-gadget

# FIXME: how can we start that twice for two separate game controllers?
# do we simply need two separate controller-gadgets?
# or do we have @HID1 as well?
# or is there a single joystick USB interface which serves left and right?

DEVICE0=hidg0
DEVICE1=hidg1
DEVICE2=hidg2
DEVICE3=hidg3

do_status () {
	if [ -e /dev/$DEVICE0 ] ; then
		echo "$SERVICE is running."
		return 0
	else
                return 4
        fi
}

case "$1" in
  start)
	log_daemon_msg "Starting $SERVICE"
	do_status && exit 0	# already running
#	/etc/gadget/core/letux-gadget.sh add hid keyboard
#	/etc/gadget/core/letux-gadget.sh add hid gamepad
	/etc/gadget/core/letux-gadget.sh add hid joystick
	/etc/gadget/core/letux-gadget.sh add hid mouse

# FIXME: how can we start that twice for two separate game controllers?
# do we simply need two separate controller-gadgets?
# or do we have @HID1 as well?
# or is there a single joystick USB interface which serves left and right?

#	daemon -r --name=$SERVICE -- /usr/bin/mipsel-linux-gnu/hidd /dev/input/snes-left /dev/$DEVICE0
#	daemon -r --name=$SERVICE -- /usr/bin/mipsel-linux-gnu/hidd /dev/input/snes-right /dev/$DEVICE1
#	daemon -r --name=$SERVICE -- /usr/bin/mipsel-linux-gnu/hidd /dev/input/sega-left /dev/$DEVICE2
#	daemon -r --name=$SERVICE -- /usr/bin/mipsel-linux-gnu/hidd /dev/input/sega-right /dev/$DEVICE3
	exit 0
	;;
  restart|reload|force-reload)
	echo "Error: argument '$1' not supported" >&2
	exit 3
	;;
  stop)
	log_daemon_msg "Stopping $SERVICE"
	do_status || exit 0	# not running
#	daemon --name=$SERVICE --stop 2>/dev/null
	/etc/gadget/core/letux-gadget.sh remove hid
	log_progress_msg "disabled."
	log_end_msg 0
	exit 0
	;;
  status)
	do_status
	exit $?
	;;
  *)
	echo "Usage: $0 start|stop|status" >&2
	exit 3
	;;
esac

:
