#!/bin/bash
# make all packages for Retrode3
#
# if we rebuild the binaries (option -b),
# this requires a Retrode3 connected and running RNDIS
# also needs to have gcc / g++ installed (apt-get install g++) there

[ "$DEV" ] || DEV=root@172.31.255.1	# for ssh and rsync

set -e

BUILD_PACKAGES=true
BUILD_TOOL=false
INSTALL_PACKAGES=false

# Default is offline metadata/package build only: never auto-deploy to a device.

while [ "$1" ]
do
	case "$1" in
		-b ) BUILD_TOOL=true;;
		-np ) BUILD_PACKAGES=false; INSTALL_PACKAGES=false;;	# no pack
		-ni ) INSTALL_PACKAGES=false;;
        --install ) INSTALL_PACKAGES=true;;	# no install
		-* ) echo unknown option "$1"; exit 1;;
		* ) break;
	esac
	shift
done

if $BUILD_TOOL; then
    echo "Legacy OSCR reader rebuild is retired. Build the pinned shared runtime in retrode3-oscr instead." >&2
    echo "See packaging/README.md for the offline MIPS stage and .deb workflow." >&2
    exit 2
fi

echo "Check Retrode3 Web v2 PHP sources (legacy UI is retired)"
for i in retrode3-web-control/v2/web/*.php;
do
	php -l $i || exit 1
done

echo "Prepare zipped groff man pages"
find . -name '*.groff' | while read MANFILE
do
	DIR=$(dirname "$MANFILE")/../
	BASE=$(basename "$MANFILE" .groff)
	SECTION=$(fgrep '.TH man ' <"$MANFILE" | cut -d ' ' -f 3)
	[ "$SECTION" ] && mkdir -p $DIR/../man/man$SECTION && gzip <$MANFILE >$DIR/../man/man$SECTION/$BASE.$SECTION.gz
done

if $BUILD_PACKAGES
then

export DEPLOY=false # Prevent QuantumSTEP side-effect deployments.
echo "Build retrode3.deb (and subpackages)"
RECURSIVE=true ./retrode3.qcodeproj	# could make others recursively but then we have no clear list
fi

if $INSTALL_PACKAGES
then

PACKAGES+=" retrode3-hidd"
PACKAGES+=" retrode3-controller-gadget"
PACKAGES+=" retrode3-storage-gadget"
PACKAGES+=" retrode3-smb"
PACKAGES+=" retrode3-udev-rules"
PACKAGES+=" ucon64"
PACKAGES+=" retrode3-tools"
PACKAGES+=" retrode3"

echo "Explicit legacy QuantumSTEP package install requested (new native/Web .debs are separate)."\necho installing Debian Packages: $PACKAGES

dl-deb $DEV $PACKAGES

echo "Web v1 is retired and no longer installed by make-all."
echo "Web v2 must be installed from a tested OS release/package or its maintained installer."
open http://172.31.255.1

fi
