#!/bin/bash -p
# retrode3-dump slot - dump cart header

CMD="$1"
[ "$CMD" ] || CMD=headers

md_ram() {
	# write mapper with TIME impulse
	printf "\x$1" | dd of=/dev/slot-md bs=1 seek="$((0x03a13000))" count=1 status=none
}

case "$CMD" in
	headers )
		if xxd -l 1 /dev/slot-md >/dev/null 2>&1
		then
			md_ram 0
			echo MD ROM Header:
			xxd -s 256 -l 256 /dev/slot-md
		else
			echo MD slot empty
		fi

		if xxd -l 1 /dev/slot-snes >/dev/null 2>&1
		then
			echo "SNES LoROM Header:"
			xxd -s 0x7fc0 -l 0x20 /dev/slot-snes
			echo "SNES HiROM Header:"
			xxd -s 0xffc0 -l 0x20 /dev/slot-snes
		else
			echo SNES slot empty
		fi

		if xxd -l 1 /dev/slot-nes >/dev/null 2>&1
		then
			echo "NES PRG:"
			# 0x0a00 is NES_PRG
			xxd -s 0x0a008000 -l 0x80 /dev/slot-nes

			# other read modes?
		else
			echo NES slot empty
		fi
		
		;;
	ram )
		if xxd -l 1 /dev/slot-md >/dev/null 2>&1
		then
			md_ram ff	# 01 would suffice but ff activates LEDs
			sleep 0.5
			echo MD RAM:
			xxd -s 0x00200000 -l 256 /dev/slot-md
			md_ram 0
		else
			echo MD slot empty
		fi
if false; then
		if xxd -l 1 /dev/slot-nes >/dev/null 2>&1
		then
			echo "NES PRG:"
			# 0x0a00 is NES_PRG
			xxd -s 0x0a008000 -l 0x80 /dev/slot-nes

			# other read modes?
		else
			echo NES slot empty
		fi
fi
		;;
	* )
		echo unknown command "$CMD"
		echo "  headers"
		exit 1
		;;
esac
