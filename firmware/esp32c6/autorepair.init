#!/bin/sh
### BEGIN INIT INFO
# Provides:          retrode3-esp-autorepair
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Guarded ESP32-C6 firmware recovery
### END INIT INFO
set -eu
case "$1" in
    start)
        [ -f /etc/retrode3/esp-autorepair-enabled ] || exit 0
        /usr/sbin/retrode3-esp-autorepair
        ;;
    stop) : ;;
    *) exit 2 ;;
esac
