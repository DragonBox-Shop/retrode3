#!/bin/sh
### BEGIN INIT INFO
# Provides:          retrode3-web-v2
# Required-Start:    $local_fs $network retrode3-core-runtime
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Retrode3 v2 local web backend
### END INIT INFO

set -e
NAME=retrode3-web-v2
PIDFILE=/var/run/retrode3-web-v2.pid
DAEMON=/opt/retrode3-web-v2/start.sh
# User-controlled configuration; never source a file writable by www-data.
if [ -r /etc/default/retrode3-web-v2 ]; then
    . /etc/default/retrode3-web-v2
fi
export RETRODE3_CORE_CONTROL_ENABLED RETRODE3_CORECTL_SUDO
case "$1" in
    start)
        if ! /etc/init.d/retrode3-core-runtime status >/dev/null 2>&1; then
            echo "OS cartridge bus lock not prepared" >&2
            exit 1
        fi
        # Temporary SysV-device setup until the OS udev package owns these
        # permissions permanently. Device nodes are recreated at boot.
        getent group retrode3-reader >/dev/null 2>&1 || {
            echo "Reader device group is missing" >&2
            exit 1
        }
        for DEVICE in /dev/slot-*; do
            [ -c "$DEVICE" ] || continue
            [ ! -L "$DEVICE" ] || {
                echo "Unsafe cartridge device symlink: $DEVICE" >&2
                exit 1
            }
            chgrp retrode3-reader "$DEVICE"
            chmod 0660 "$DEVICE"
        done
        # The trusted shared CLI applies its v3 plugin's short-lived
        # hardware profile. Grant ONLY these root-owned, kernel-validated
        # control attributes to the same cartridge reader group as /dev.
        # The browser never receives raw paths or write operations.
        for CONTROL in /sys/module/retrode3/parameters/gbx_md_test \
                       /sys/module/retrode3/parameters/legacy_bridge_hiz_test \
                       /sys/module/retrode3/parameters/sms_mapper_write_test \
                       /sys/class/retrode3/slot-*/vcc; do
            [ -e "$CONTROL" ] || continue
            [ ! -L "$CONTROL" ] || {
                echo "Unsafe kernel control symlink: $CONTROL" >&2
                exit 1
            }
            chgrp retrode3-reader "$CONTROL"
            chmod 0660 "$CONTROL"
        done
        if start-stop-daemon --status --pidfile "$PIDFILE" >/dev/null 2>&1; then
            echo "$NAME already running"
            exit 0
        fi
        if [ -L "$PIDFILE" ]; then
            echo "Unsafe pidfile symlink" >&2
            exit 1
        fi
        rm -f "$PIDFILE"
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$PIDFILE" --chuid www-data --startas "$DAEMON"
        echo "$NAME started"
        ;;
    stop)
        start-stop-daemon --stop --quiet --oknodo --retry TERM/5/KILL/2 \
            --pidfile "$PIDFILE" || true
        rm -f "$PIDFILE"
        echo "$NAME stopped"
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        if start-stop-daemon --status --pidfile "$PIDFILE" >/dev/null 2>&1; then
            echo "$NAME running"
        else
            echo "$NAME stopped"
            exit 3
        fi
        ;;
    *)
        echo "Usage: $0 start|stop|restart|status" >&2
        exit 2
        ;;
esac
