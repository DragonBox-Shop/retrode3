#!/bin/sh
# Dedicated USB-only IPv4 network. Never act as a DHCP client on USB.
# WLAN obtains its own address, DNS and default route independently.
set -eu
R=/run/retrode3-usb-network
mkdir -m 0755 -p "$R"
child=
cleanup() {
    if [ -n "$child" ]; then
        kill "$child" 2>/dev/null || :
        wait "$child" 2>/dev/null || :
    fi
    ip -4 addr del 172.31.255.1/29 dev usb0 2>/dev/null || :
    rm -f "$R/server.pid"
}
trap 'exit 0' TERM INT
trap cleanup EXIT
# The gadget has already created usb0 and brought it up. Set the address
# immediately, even before the host opens its NCM link.
ip -4 addr replace 172.31.255.1/29 dev usb0
while [ -d /sys/class/net/usb0 ]; do
    /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/dev/null \
        --port=0 --interface=usb0 --bind-interfaces --dhcp-authoritative \
        --dhcp-range=172.31.255.2,172.31.255.6,255.255.255.248,12h \
        --dhcp-option=3 --dhcp-option=6 --dhcp-leasefile="$R/server.leases" \
        --pid-file="$R/server.pid" >/dev/null 2>&1 &
    child=$!
    echo "USB: local DHCP, 172.31.255.1"
    # Keep DHCP across host link changes; restart only on process failure.
    while [ -d /sys/class/net/usb0 ] && kill -0 "$child" 2>/dev/null; do
        sleep 1
    done
    kill "$child" 2>/dev/null || :
    wait "$child" 2>/dev/null || :
    child=
    [ -d /sys/class/net/usb0 ] || break
    sleep 2
done
