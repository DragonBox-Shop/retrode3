#!/bin/sh
# kFreeBSD do not accept scripts as interpreters, using #!/bin/sh and sourcing.
if [ true != "$INIT_D_SCRIPT_SOURCED" ] ; then
    set "$0" "$@"; INIT_D_SCRIPT_SOURCED=true . /lib/init/init-d-script
fi
### BEGIN INIT INFO
# Provides:          retrode3-storage-gadget
# Required-Start:    letux-storage-gadget
# Required-Stop:
# Default-Start:     
# Default-Stop:      0 1 2 3 4 5 6
# Short-Description: Mass Storage gadget for Retrode3
# Description:       Fill backing store at /var/storage0
#                    
### END INIT INFO

# Author: H. Nikolaus Schaller <hns@goldelico.com>

SERVICE=retrode3-storage-gadget
DEVICE=/var/storage0.img
BLOCKS=100 # increase block count if we need more space
NAME=RETRODE3
FILES=/tmp/retrode3-storage.$$
STAGED=${DEVICE}.new.$$

# Build a new FAT image without unlinking the image currently open by
# USB Mass Storage. The new inode is used on the next USB reattach/boot.
build_image () {
        mkdir -p "$FILES" || return 1
        rm -f "$STAGED"
        if ! /sbin/mkfs.vfat -C -n "$NAME" "$STAGED" "$BLOCKS"; then
                rmdir "$FILES"
                return 1
        fi
        if ! mount -o loop "$STAGED" "$FILES"; then
                rm -f "$STAGED"
                rmdir "$FILES"
                return 1
        fi
        if ! cp -R /media/usb-storage/. "$FILES/"; then
                if umount "$FILES"; then
                        rm -f "$STAGED"
                        rmdir "$FILES" 2>/dev/null || :
                else
                        echo "Staged FAT image remains mounted at $FILES" >&2
                fi
                return 1
        fi
        sync
        if ! umount "$FILES"; then
                echo "Could not unmount staged Retrode3 storage image" >&2
                return 1
        fi
        rmdir "$FILES" || return 1
        mv -f "$STAGED" "$DEVICE" || return 1
        echo "Updated $DEVICE; new contents appear after USB reconnect/reboot"
}

do_status () {
	if fgrep -q "$DEVICE" /sys/kernel/config/usb_gadget/letux/functions/mass_storage.usb0/lun.*/file 2>/dev/null
	then
		echo "$SERVICE is running."
		return 0
	else
                return 4
        fi
}

case "$1" in
  start)
        log_daemon_msg "Starting $SERVICE"
        do_status && exit 0	# already running

        if [ ! -r "$DEVICE" ]; then
                build_image || exit 1
        fi

	/usr/sbin/service letux-storage-gadget@storage0 start

        exit 0
        ;;
  prepare)
        # Safe on a live USB Mass Storage gadget: image file is replaced
        # atomically, existing open image remains available to the host.
        build_image
        exit $?
        ;;
  restart|reload|force-reload)
        echo "Error: argument '$1' not supported" >&2
        exit 3
        ;;
  stop)
        log_daemon_msg "Stopping $SERVICE"
        do_status || exit 0	# not running
        /usr/sbin/service letux-storage-gadget@storage0 stop
        log_progress_msg "disabled."
        log_end_msg 0
        exit 0
        ;;
  status)
	do_status
	exit $?
	;;
  *)
        echo "Usage: $0 start|stop|status|prepare" >&2
        exit 3
        ;;
esac

:
