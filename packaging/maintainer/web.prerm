#!/bin/sh
set -e
case "${1:-}" in
    remove|deconfigure)
        if [ -x /etc/init.d/retrode3-web-v2 ]; then
            /etc/init.d/retrode3-web-v2 stop
        fi
        link=/etc/lighttpd/conf-enabled/99-retrode3-lighttpd.conf
        if [ -L "$link" ] && [ "$(readlink "$link")" = ../conf-available/99-retrode3-lighttpd.conf ]; then
            rm "$link"
            invoke-rc.d lighttpd reload || true
        fi
        ;;
    upgrade|failed-upgrade)
        # Do not stop a running job as part of unpacking an upgrade.
        ;;
esac
exit 0
