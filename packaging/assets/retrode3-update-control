#!/usr/bin/python3
"""Asynchronous, restricted Retrode3 software and kernel updates."""
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

RUNTIME = Path("/run/retrode3-update")
BUS = Path("/run/lock/retrode3/bus.lock")
SOURCE = Path("/etc/apt/sources.list.d/retrode3.list")
KEY = Path("/usr/share/keyrings/retrode3-archive-keyring.gpg")
WEB = "/etc/init.d/retrode3-web-v2"
LOG = Path("/var/log/retrode3-update.log")
ENV = dict(os.environ, LC_ALL="C", DEBIAN_FRONTEND="noninteractive")
PACKAGE = re.compile(r"retrode3-(?:web-control|tools|udev-rules|cores|core-runtime|core-[a-z0-9]+(?:-[a-z0-9]+)*)")
VERSION = re.compile(r"[0-9][a-zA-Z0-9.+:~_-]*")


KERNEL_PACKAGES = {"retrode3-linux-image", "retrode3-linux-modules"}


def allowed(name):
    return name in KERNEL_PACKAGES or bool(PACKAGE.fullmatch(name))


def save(phase, packages=None, message=""):
    data = {"phase": phase, "packages": packages or [], "message": message}
    fd, name = tempfile.mkstemp(dir=RUNTIME, prefix=".state-")
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(data, stream)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
        os.replace(name, RUNTIME / "status.json")
    finally:
        if os.path.exists(name):
            os.unlink(name)
    return data


def state():
    try:
        return json.loads((RUNTIME / "status.json").read_text())
    except FileNotFoundError:
        return {"phase": "idle", "packages": [], "message": ""}


def apt_base():
    expected = (r"deb \[arch=mipsel signed-by=/usr/share/keyrings/retrode3-archive-keyring.gpg\] "
                r"https://packages\.retrode\.com (testing|stable) main")
    if (SOURCE.is_symlink() or not re.fullmatch(expected, SOURCE.read_text().strip())
            or KEY.is_symlink() or not KEY.is_file() or not KEY.stat().st_size):
        raise ValueError("Expected signed Retrode3 APT source missing")
    return ["/usr/bin/apt-get", "-o", "Dir::Etc::sourcelist=" + str(SOURCE),
            "-o", "Dir::Etc::sourceparts=-", "-o", "APT::Get::AllowUnauthenticated=false",
            "-o", "Acquire::AllowInsecureRepositories=false", "-o", "Acquire::Retries=1",
            "-o", "Acquire::https::Timeout=20", "-o", "DPkg::Lock::Timeout=10",
            "-o", "Dir::Log::Planner=/dev/null",
            "-o", "DPkg::Options::=--force-confold", "--no-install-recommends", "--no-remove"]


def capture(args):
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, env=ENV, timeout=90)
    if result.returncode:
        raise ValueError("Package inspection failed (exit %d)" % result.returncode)
    return result.stdout


def installed():
    if capture(["/usr/bin/dpkg", "--audit"]).strip():
        raise ValueError("Package database needs repair before updating")
    rows = capture(["/usr/bin/dpkg-query", "-W",
                    "-f=${Package}\t${db:Status-Status}\n"])
    packages = sorted({name for name, _, status in
                       (row.partition("\t") for row in rows.splitlines())
                       if status == "installed" and allowed(name)})
    if "retrode3-web-control" not in packages:
        raise ValueError("Retrode3 Web package is not installed")
    return packages


def parse_plan(output):
    result = []
    for row in output.splitlines():
        if row.startswith(("Remv ", "Purg ")):
            raise ValueError("Update would remove packages")
        if row.startswith("Conf "):
            name = row.split()[1].removesuffix(":mipsel")
            if not allowed(name):
                raise ValueError("Update would configure an unsupported package")
        if not row.startswith("Inst "):
            continue
        match = re.match(r"^Inst (\S+)(?: \[([^\]]+)\])? \((\S+)(?: |\))", row)
        if not match:
            raise ValueError("Unrecognized APT update plan")
        name, old, new = match.groups()
        name = name.removesuffix(":mipsel")
        if not allowed(name) or not VERSION.fullmatch(new):
            raise ValueError("Update would change unsupported package: " + name)
        if old:
            comparison = subprocess.run(["/usr/bin/dpkg", "--compare-versions", new, "lt", old],
                                        env=ENV).returncode
            if comparison != 1:
                raise ValueError("Update would downgrade package or has invalid version: " + name)
        result.append({"name": name, "installed": old or "", "candidate": new})
    return sorted(result, key=lambda p: p["name"])


def validate_kernel_plan(plan):
    kernel = [p for p in plan if p["name"] in KERNEL_PACKAGES]
    if not kernel:
        return
    if ({p["name"] for p in kernel} != KERNEL_PACKAGES or len(kernel) != 2 or
            len({p["candidate"] for p in kernel}) != 1):
        raise ValueError("Kernel and modules must be updated together at the same version")
    for pkg in kernel:
        info = capture(["/usr/bin/apt-cache",
                        "-o", "Dir::Etc::sourcelist=" + str(SOURCE),
                        "-o", "Dir::Etc::sourceparts=-", "show",
                        pkg["name"] + "=" + pkg["candidate"]])
        # Do not advertise historical staged-only candidates as usable updates.
        if not re.search(r"(?m)^X-Retrode3-Kernel-Layout: live-v1\s*$", info):
            raise ValueError("Selected kernel package is staged-only; an installable kernel update is required")


def simulate(base, targets):
    plan = parse_plan(capture(base + ["-s", "install"] + targets))
    validate_kernel_plan(plan)
    return plan


def command(args, log, timeout=None):
    result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=log,
                            stderr=subprocess.STDOUT, env=ENV, timeout=timeout)
    if result.returncode:
        raise ValueError("Package command failed (exit %d); see /var/log/retrode3-update.log" % result.returncode)


def sync_clock(log):
    """Best-effort NTP recovery before network APT operations.

    A valid RTC may already provide correct time without an NTP server.
    Never bypass APT's own signed Release date or TLS checks.
    """
    def chrony(*args, timeout=3):
        try:
            return subprocess.run(["/usr/bin/chronyc", "-n", *args],
                                  stdin=subprocess.DEVNULL, stdout=log,
                                  stderr=subprocess.STDOUT, env=ENV,
                                  timeout=timeout).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return False

    log.write(b"Checking clock synchronization before APT...\n")
    log.flush()
    if chrony("waitsync", "1", "1.0", "0", "1"):
        return
    # The WLAN/DNS may not have been ready when chronyd started.
    chrony("refresh")
    chrony("online")
    chrony("burst", "4/4")
    if not chrony("waitsync", "15", "1.0", "0", "1", timeout=20):
        log.write(b"WARNING: NTP synchronization not confirmed; "
                  b"continuing with normal APT time validation.\n")
        log.flush()


def worker(action, lock_fd, bus_fd):
    stopped = False
    plan = []
    try:
        base = apt_base()
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as log:
            os.fchmod(log.fileno(), 0o600)
            if action == "check":
                sync_clock(log)
                command(base + ["-o", "APT::Update::Error-Mode=any", "update"], log, 180)
                plan = simulate(base, installed())
                save("available" if plan else "current", plan)
                return
            plan = state()["packages"]
            if not plan or simulate(base, installed()) != plan:
                raise ValueError("Available packages changed. Check for updates again.")
            targets = [p["name"] + "=" + p["candidate"] for p in plan]
            if simulate(base, targets) != plan:
                raise ValueError("Exact update plan changed. Check again.")
            save("downloading", plan)
            sync_clock(log)
            command(base + ["-y", "--download-only", "install"] + targets, log, 600)
            if simulate(base, targets) != plan:
                raise ValueError("Update plan changed after download")
            save("installing", plan)
            # Hold the native bus lock across package changes; stop the web
            # backend first, including when its Basic Auth is enabled.
            stopped = True
            command([WEB, "stop"], log, 30)
            if subprocess.run([WEB, "status"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0:
                raise ValueError("Web backend did not stop")
            # Never impose a timeout on a running dpkg transaction.
            command(base + ["-y", "--no-download", "install"] + targets, log)
            for pkg in plan:
                actual = capture(["/usr/bin/dpkg-query", "-W",
                                  "-f=${db:Status-Status}\t${Version}", pkg["name"]])
                if actual.strip() != "installed\t" + pkg["candidate"]:
                    raise ValueError("Could not verify installed package: " + pkg["name"])
            save("restarting", plan)
            command([WEB, "start"], log, 30)
            stopped = False
            save("done", plan)
    except (OSError, ValueError, subprocess.SubprocessError, KeyError) as exc:
        if stopped:
            try:
                subprocess.run([WEB, "start"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=30)
            except (OSError, subprocess.SubprocessError):
                pass
        save("failed", plan, str(exc) if isinstance(exc, ValueError) else
             "Update failed; see /var/log/retrode3-update.log")
    finally:
        if bus_fd >= 0:
            os.close(bus_fd)
        os.close(lock_fd)


def start(action):
    RUNTIME.mkdir(mode=0o755, exist_ok=True)
    st = RUNTIME.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        raise ValueError("Unsafe update directory")
    lock_fd = os.open(RUNTIME / "lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o644)
    bus_fd = -1
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("An update operation is already running") from None
        plan = state()
        if action == "install" and (plan["phase"] != "available" or not plan["packages"]):
            raise ValueError("Check for available updates first")
        # Even refreshing APT lists uses RAM; do not compete with a dump.
        bus_fd = os.open(BUS, os.O_RDWR | os.O_NOFOLLOW)
        if not stat.S_ISREG(os.fstat(bus_fd).st_mode):
            raise ValueError("Invalid cartridge bus lock")
        try:
            fcntl.flock(bus_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("Cartridge hardware busy; try again when idle") from None
        data = save("checking" if action == "check" else "downloading",
                    plan["packages"] if action == "install" else [])
        fds = (lock_fd,) if bus_fd < 0 else (lock_fd, bus_fd)
        try:
            subprocess.Popen([sys.executable, __file__, "--worker", action, str(lock_fd), str(bus_fd)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True, pass_fds=fds)
        except OSError:
            save("failed", message="Could not start update worker")
            raise
        return data
    finally:
        if bus_fd >= 0:
            os.close(bus_fd)
        os.close(lock_fd)


def main():
    if os.geteuid() != 0:
        raise ValueError("Root required")
    if len(sys.argv) == 5 and sys.argv[1] == "--worker" and sys.argv[2] in ("check", "install"):
        worker(sys.argv[2], int(sys.argv[3]), int(sys.argv[4]))
        return
    if len(sys.argv) != 1:
        raise ValueError("Invalid invocation")
    raw = sys.stdin.buffer.read(257)
    if len(raw) > 256:
        raise ValueError("Invalid update request")
    data = json.loads(raw)
    if not isinstance(data, dict) or set(data) != {"action"} or data["action"] not in ("check", "install"):
        raise ValueError("Only check or install is supported")
    print(json.dumps(start(data["action"])))


if __name__ == "__main__":
    os.umask(0o022)
    try:
        main()
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as exc:
        print(json.dumps({"error": str(exc) if isinstance(exc, ValueError) else "Update control unavailable"}))
        sys.exit(1)
