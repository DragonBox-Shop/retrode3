#!/usr/bin/python3
"""Narrow, root-only SSH control. No user-controlled arguments or shell."""
import crypt
import fcntl
import hmac
import json
import os
import re
import spwd
import stat
import subprocess
import sys
from pathlib import Path

AUTH = Path("/etc/retrode3-web-control.auth")
MARKER = Path("/etc/retrode3/ssh-enabled")
SERVICE = "/etc/init.d/retrode3-ssh"

def valid_auth():
    try:
        st = AUTH.lstat()
        return (stat.S_ISREG(st.st_mode) and st.st_uid == 0
                and not st.st_mode & 0o022
                and re.fullmatch(r"\$2[aby]\$\d\d\$[./A-Za-z0-9]{53}", AUTH.read_text().strip()))
    except (OSError, UnicodeError):
        return False

def run(action):
    return subprocess.run([SERVICE, action], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, timeout=20).returncode

def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise ValueError("Invalid invocation")
    os.umask(0o077)
    runtime = Path("/run/retrode3-ssh-control")
    runtime.mkdir(mode=0o700, exist_ok=True)
    st = runtime.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077:
        raise ValueError("Unsafe SSH control runtime directory")
    with open(runtime / "lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        raw = sys.stdin.buffer.read(4097)
        if len(raw) > 4096:
            raise ValueError("SSH control request too large")
        data = json.loads(raw)
        action = data.get("action")
        if action == "status":
            return {"configured": bool(valid_auth()),
                    "enabled": MARKER.is_file(), "running": run("status") == 0}
        if action not in ("enable", "disable") or not valid_auth():
            raise ValueError("Developer access requires a configured web password")
        password = data.get("web_password")
        if not isinstance(password, str) or not 1 <= len(password.encode()) <= 72 or "\0" in password:
            raise ValueError("Invalid developer password")
        stored = AUTH.read_text().strip()
        check = crypt.crypt(password, stored)
        if not check or not hmac.compare_digest(check, stored):
            raise ValueError("Invalid developer password")
        if action == "disable":
            MARKER.unlink(missing_ok=True)
            if run("stop"):
                raise ValueError("SSH stop failed")
        else:
            ssh = data.get("ssh_password")
            if not isinstance(ssh, str) or not 12 <= len(ssh.encode()) <= 72 or any(c in ssh for c in "\0\r\n:"):
                raise ValueError("SSH password must be 12-72 UTF-8 bytes without colon or line breaks")
            if run("status") == 0:
                raise ValueError("Disable SSH before changing its password")
            if not Path("/usr/lib/openssh/sftp-server").is_file():
                raise ValueError("SFTP server missing")
            # chpasswd receives the secret over stdin, not argv or a log.
            subprocess.run(["/usr/sbin/chpasswd"], input="root:" + ssh + "\n",
                           text=True, check=True, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=20)
            if spwd.getspnam("root").sp_pwdp.startswith(("!", "*")):
                raise ValueError("Root account remains locked")
            MARKER.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
            MARKER.touch(mode=0o600)
            if run("start") or run("status"):
                MARKER.unlink(missing_ok=True)
                run("stop")
                raise ValueError("SSH startup failed; root password has been changed")
        return {"configured": True, "enabled": MARKER.is_file(), "running": run("status") == 0}

if __name__ == "__main__":
    try:
        print(json.dumps(main()))
    except (ValueError, OSError, subprocess.SubprocessError, TypeError, AttributeError) as exc:
        print(json.dumps({"error": str(exc) if isinstance(exc, ValueError) else "SSH control failed"}))
        sys.exit(1)
