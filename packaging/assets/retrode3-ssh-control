#!/usr/bin/python3
"""Root-only developer control. The sole developer credential is root's shadow hash."""
import base64
import binascii
import crypt
import hashlib
import fcntl
import hmac
import json
import os
import re
import spwd
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

MARKER = Path("/etc/retrode3/ssh-enabled")
KEY_ONLY = Path("/etc/retrode3/ssh-key-only")
SERVICE = "/etc/init.d/retrode3-ssh"
LEGACY = Path("/etc/retrode3-developer.auth")
KEY_FILE = Path("/root/.ssh/authorized_keys")

def root_hash():
    return spwd.getspnam("root").sp_pwdp

def configured(stored):
    # Locked or unknown hashes must not be accepted as usable passwords.
    return bool(re.fullmatch(r"\$(?:y|6|5|2[aby]|1)\$[^\s:]+", stored))

def setup_needed(stored):
    # Do not overwrite a previously provisioned but locked root credential.
    return stored in ("!", "!!", "*") and not os.path.lexists(LEGACY)

def run(action):
    return subprocess.run([SERVICE, action], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, timeout=20).returncode

def parse_key(line):
    """Accept one plain OpenSSH public key, never options or private keys."""
    if not isinstance(line, str) or len(line.encode("utf-8")) > 4096:
        raise ValueError("Invalid public key size")
    line = line.strip()
    if any(c in line for c in "\r\n\0"):
        raise ValueError("Upload exactly one public key")
    fields = line.split(None, 2)
    if len(fields) < 2:
        raise ValueError("Invalid OpenSSH public key")
    kind, encoded = fields[:2]
    curves = {"ecdsa-sha2-nistp256": (b"nistp256", 65),
              "ecdsa-sha2-nistp384": (b"nistp384", 97),
              "ecdsa-sha2-nistp521": (b"nistp521", 133)}
    if kind not in ("ssh-ed25519", "ssh-rsa") and kind not in curves:
        raise ValueError("Unsupported public key type")
    try:
        blob = base64.b64decode(encoded, validate=True)
        parts = []
        pos = 0
        while pos < len(blob):
            if len(parts) >= 3 or pos + 4 > len(blob):
                raise ValueError()
            n = int.from_bytes(blob[pos:pos+4], "big")
            pos += 4
            if n == 0 or pos + n > len(blob):
                raise ValueError()
            parts.append(blob[pos:pos+n])
            pos += n
        if not parts or parts[0] != kind.encode("ascii"):
            raise ValueError()
        if kind == "ssh-ed25519":
            if len(parts) != 2 or len(parts[1]) != 32:
                raise ValueError()
        elif kind == "ssh-rsa":
            if len(parts) != 3 or any(p[0] & 128 for p in parts[1:]):
                raise ValueError()
            if int.from_bytes(parts[1], "big") < 3 or int.from_bytes(parts[2], "big").bit_length() < 1024:
                raise ValueError()
        else:
            curve, size = curves[kind]
            if len(parts) != 3 or parts[1] != curve or len(parts[2]) != size or parts[2][0] != 4:
                raise ValueError()
    except (ValueError, binascii.Error):
        raise ValueError("Invalid OpenSSH public key data") from None
    fingerprint = "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode("ascii").rstrip("=")
    comment = fields[2] if len(fields) == 3 else ""
    if any(ord(c) < 32 or ord(c) == 127 for c in comment):
        raise ValueError("Invalid public key comment")
    normalized = kind + " " + base64.b64encode(blob).decode("ascii")
    if comment:
        normalized += " " + comment
    return normalized, {"type": kind, "fingerprint": fingerprint, "comment": comment}


def key_lines(create=False):
    parent = KEY_FILE.parent
    if create:
        parent.mkdir(mode=0o700, exist_ok=True)
    try:
        st = parent.lstat()
    except FileNotFoundError:
        return []
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError("Unsafe SSH key directory")
    try:
        st = KEY_FILE.lstat()
    except FileNotFoundError:
        return []
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022 or st.st_size > 65536:
        raise ValueError("Unsafe SSH authorized_keys file")
    return KEY_FILE.read_bytes().splitlines(keepends=True)


def key_info(line):
    try:
        return parse_key(line.decode("utf-8"))[1]
    except (ValueError, UnicodeError):
        return None


def list_keys():
    keys = {}
    for line in key_lines():
        info = key_info(line)
        if info:
            keys[info["fingerprint"]] = info
    return list(keys.values())


def update_keys(data):
    lines = key_lines(create=True)
    if data["action"] == "add_key":
        line, info = parse_key(data.get("public_key"))
        if any((key_info(old) or {}).get("fingerprint") == info["fingerprint"] for old in lines):
            return
        if lines and not lines[-1].endswith(b"\n"):
            lines[-1] += b"\n"
        lines.append((line + "\n").encode("utf-8"))
    else:
        fingerprint = data.get("fingerprint")
        if not isinstance(fingerprint, str) or not re.fullmatch(r"SHA256:[A-Za-z0-9+/]{43}", fingerprint):
            raise ValueError("Invalid public key fingerprint")
        lines = [line for line in lines if (key_info(line) or {}).get("fingerprint") != fingerprint]
        if KEY_ONLY.is_file() and not any(key_info(line) for line in lines):
            raise ValueError("Enable SSH password login before removing the last public key")
    payload = b"".join(lines)
    if len(payload) > 65536:
        raise ValueError("Too many authorized keys")
    os.chmod(KEY_FILE.parent, 0o700)
    fd, temp = tempfile.mkstemp(prefix=".authorized_keys.", dir=KEY_FILE.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, KEY_FILE)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def status():
    stored = root_hash()
    running = run("status") == 0
    enabled = MARKER.is_file()
    return {"configured": configured(stored),
            "setup_needed": setup_needed(stored) and not enabled and not running,
            "enabled": enabled, "running": running, "keys": list_keys(),
            "password_login": not KEY_ONLY.is_file()}

def set_password(data):
    password = data.get("new_password")
    if (not isinstance(password, str) or not 1 <= len(password.encode("utf-8")) <= 512
            or any(c in password for c in "\0\r\n:")
            or password != data.get("repeat_password")):
        raise ValueError("Passwords must match and be non-empty (no colon, NUL or line breaks; max 512 UTF-8 bytes)")
    # Avoid the memory-intensive default PAM/yescrypt hashing path on MIPS.
    # shadow-utils handles locking and updating the shadow file; only a salted
    # hash is passed via stdin, never a password or hash in argv or logs.
    hashed = crypt.crypt(password, crypt.mksalt(crypt.METHOD_SHA512))
    if not hashed or not hashed.startswith("$6$") or not configured(hashed):
        raise ValueError("Could not generate the root password hash")
    try:
        result = subprocess.run(["/usr/sbin/chpasswd", "-e"],
                                input="root:" + hashed + "\n", text=True,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                timeout=20)
    except subprocess.TimeoutExpired:
        raise ValueError("Root password update timed out") from None
    except OSError:
        raise ValueError("Could not execute chpasswd") from None
    if result.returncode:
        raise ValueError("Could not update the root password (chpasswd exit code %d). Check writable root filesystem and shadow file." % result.returncode)
    if not hmac.compare_digest(root_hash(), hashed):
        raise ValueError("Root password update could not be verified")

def authenticate(data, runtime):
    stored = root_hash()
    password = data.get("developer_password")
    if not configured(stored):
        raise ValueError("Root password is not configured or is locked")
    if not isinstance(password, str) or not 1 <= len(password.encode("utf-8")) <= 1024 or "\0" in password:
        raise ValueError("Invalid developer password")
    failure = runtime / "last-failure"
    if failure.exists() and time.monotonic() - float(failure.read_text()) < 3:
        raise ValueError("Retry developer authentication after three seconds")
    check = crypt.crypt(password, stored)
    if not check or not hmac.compare_digest(check, stored):
        failure.write_text(str(time.monotonic()))
        raise ValueError("Invalid developer password")
    failure.unlink(missing_ok=True)

def set_password_login(enabled):
    if type(enabled) is not bool:
        raise ValueError("Invalid SSH password login setting")
    previous = KEY_ONLY.is_file()
    if not enabled and not list_keys():
        raise ValueError("Add a public key before disabling SSH password login")
    if previous == (not enabled):
        return
    running = run("status") == 0

    def apply(key_only):
        if key_only:
            KEY_ONLY.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
            KEY_ONLY.touch(mode=0o600)
        else:
            KEY_ONLY.unlink(missing_ok=True)

    apply(not enabled)
    if running:
        try:
            if run("restart") or run("status"):
                raise ValueError("SSH restart failed")
        except (ValueError, OSError, subprocess.SubprocessError):
            apply(previous)
            try:
                restored = run("restart") == 0 and run("status") == 0
            except (OSError, subprocess.SubprocessError):
                restored = False
            if not restored:
                raise ValueError("SSH restart failed; previous setting restored but SSH is not confirmed running") from None
            raise ValueError("SSH restart failed; previous setting restored") from None


def dispatch(data, runtime):
    if not isinstance(data, dict):
        raise ValueError("Expected an object")
    action = data.get("action")
    if action == "status":
        return status()
    if action == "setup":
        # Gateway restricts first-time setup to direct USB; independently
        # refuse to replace any existing credential or active SSH state.
        if not status()["setup_needed"]:
            raise ValueError("Initial setup is unavailable")
        set_password(data)
        return status()
    if action not in ("enable", "disable", "change_password", "add_key", "remove_key", "set_password_login"):
        raise ValueError("Unknown developer action")
    authenticate(data, runtime)
    if action == "change_password":
        set_password(data)
    elif action == "set_password_login":
        set_password_login(data.get("enabled"))
    elif action in ("add_key", "remove_key"):
        update_keys(data)
    elif action == "disable":
        MARKER.unlink(missing_ok=True)
        if run("stop"):
            raise ValueError("SSH stop failed")
    else:
        if KEY_ONLY.is_file() and not list_keys():
            raise ValueError("Add a public key or enable SSH password login first")
        if not Path("/usr/lib/openssh/sftp-server").is_file():
            raise ValueError("SFTP server missing")
        MARKER.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        MARKER.touch(mode=0o600)
        if run("start") or run("status"):
            MARKER.unlink(missing_ok=True)
            run("stop")
            raise ValueError("SSH startup failed")
    return status()

def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise ValueError("Invalid invocation")
    os.umask(0o077)
    runtime = Path("/run/retrode3-ssh-control")
    runtime.mkdir(mode=0o700, exist_ok=True)
    st = runtime.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077:
        raise ValueError("Unsafe SSH control runtime directory")
    # Read bounded input before locking to avoid blocking another request.
    raw = sys.stdin.buffer.read(8193)
    if len(raw) > 8192:
        raise ValueError("SSH control request too large")
    data = json.loads(raw)
    with open(runtime / "lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return dispatch(data, runtime)

if __name__ == "__main__":
    try:
        print(json.dumps(main()))
    except (ValueError, OSError, subprocess.SubprocessError, TypeError, AttributeError) as exc:
        print(json.dumps({"error": str(exc) if isinstance(exc, ValueError) else "SSH control failed"}))
        sys.exit(1)
