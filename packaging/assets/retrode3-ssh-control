#!/usr/bin/python3
"""Root-only developer control. The sole developer credential is root's shadow hash."""
import crypt
import fcntl
import hmac
import json
import os
import re
import spwd
import stat
import subprocess
import sys
import time
from pathlib import Path

MARKER = Path("/etc/retrode3/ssh-enabled")
SERVICE = "/etc/init.d/retrode3-ssh"
LEGACY = Path("/etc/retrode3-developer.auth")

def root_hash():
    return spwd.getspnam("root").sp_pwdp

def configured(stored):
    # Locked or unknown hashes must not be accepted as usable passwords.
    return bool(re.fullmatch(r"\$(?:y|6|5|2[aby]|1)\$[^\s:]+", stored))

def setup_needed(stored):
    # Do not overwrite a previously provisioned but locked root credential.
    return stored in ("!", "!!", "*") and not os.path.lexists(LEGACY)

def run(action):
    return subprocess.run([SERVICE, action], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, timeout=20).returncode

def status():
    stored = root_hash()
    running = run("status") == 0
    enabled = MARKER.is_file()
    return {"configured": configured(stored),
            "setup_needed": setup_needed(stored) and not enabled and not running,
            "enabled": enabled, "running": running}

def set_password(data):
    password = data.get("new_password")
    if (not isinstance(password, str) or not 12 <= len(password.encode("utf-8")) <= 72
            or any(c in password for c in "\0\r\n:")
            or password != data.get("repeat_password")):
        raise ValueError("Passwords must match: 12-72 UTF-8 bytes, no colon or line breaks")
    # chpasswd receives the password exclusively through stdin.
    subprocess.run(["/usr/sbin/chpasswd"], input="root:" + password + "\n",
                   text=True, check=True, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=20)
    if not configured(root_hash()):
        raise ValueError("Root password is not usable")

def authenticate(data, runtime):
    stored = root_hash()
    password = data.get("developer_password")
    if not configured(stored):
        raise ValueError("Root password is not configured or is locked")
    if not isinstance(password, str) or not 1 <= len(password.encode("utf-8")) <= 1024 or "\0" in password:
        raise ValueError("Invalid developer password")
    failure = runtime / "last-failure"
    if failure.exists() and time.monotonic() - float(failure.read_text()) < 3:
        raise ValueError("Retry developer authentication after three seconds")
    check = crypt.crypt(password, stored)
    if not check or not hmac.compare_digest(check, stored):
        failure.write_text(str(time.monotonic()))
        raise ValueError("Invalid developer password")
    failure.unlink(missing_ok=True)

def dispatch(data, runtime):
    if not isinstance(data, dict):
        raise ValueError("Expected an object")
    action = data.get("action")
    if action == "status":
        return status()
    if action == "setup":
        # Gateway restricts first-time setup to direct USB; independently
        # refuse to replace any existing credential or active SSH state.
        if not status()["setup_needed"]:
            raise ValueError("Initial setup is unavailable")
        set_password(data)
        return status()
    if action not in ("enable", "disable", "change_password"):
        raise ValueError("Unknown developer action")
    authenticate(data, runtime)
    if action == "change_password":
        set_password(data)
    elif action == "disable":
        MARKER.unlink(missing_ok=True)
        if run("stop"):
            raise ValueError("SSH stop failed")
    else:
        if not Path("/usr/lib/openssh/sftp-server").is_file():
            raise ValueError("SFTP server missing")
        MARKER.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        MARKER.touch(mode=0o600)
        if run("start") or run("status"):
            MARKER.unlink(missing_ok=True)
            run("stop")
            raise ValueError("SSH startup failed")
    return status()

def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise ValueError("Invalid invocation")
    os.umask(0o077)
    runtime = Path("/run/retrode3-ssh-control")
    runtime.mkdir(mode=0o700, exist_ok=True)
    st = runtime.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077:
        raise ValueError("Unsafe SSH control runtime directory")
    # Read bounded input before locking to avoid blocking another request.
    raw = sys.stdin.buffer.read(4097)
    if len(raw) > 4096:
        raise ValueError("SSH control request too large")
    data = json.loads(raw)
    with open(runtime / "lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return dispatch(data, runtime)

if __name__ == "__main__":
    try:
        print(json.dumps(main()))
    except (ValueError, OSError, subprocess.SubprocessError, TypeError, AttributeError) as exc:
        print(json.dumps({"error": str(exc) if isinstance(exc, ValueError) else "SSH control failed"}))
        sys.exit(1)
